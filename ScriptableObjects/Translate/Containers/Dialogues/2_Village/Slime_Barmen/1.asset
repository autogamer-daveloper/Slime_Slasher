  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: Hey Player, we've been waiting for you, there's a secret room behind the
      closet on the right, come in.
  - text: "\u042D\u0439, \u0418\u0433\u0440\u043E\u043A, \u043C\u044B \u0436\u0434\u0430\u043B\u0438
      \u0442\u0435\u0431\u044F, \u0437\u0430 \u0448\u043A\u0430\u0444\u043E\u043C
      \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u0430\u044F \u043A\u043E\u043C\u043D\u0430\u0442\u0430,
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438."
  - text: "\u563F\uFF0C\u73A9\u5BB6\uFF0C\u6211\u4EEC\u4E00\u76F4\u5728\u7B49\u4F60\uFF0C\u67DC\u5B50\u540E\u9762\u6709\u4E2A\u79D8\u5BC6\u623F\u95F4\uFF0C\u8FDB\u53BB\u5427\u3002"
