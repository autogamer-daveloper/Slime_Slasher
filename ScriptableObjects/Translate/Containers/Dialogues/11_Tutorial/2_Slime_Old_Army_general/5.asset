  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: 5
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: "Have you lost your mind? We\u2019ll take it to the warehouse and help
      our comrades."
  - text: "\u0422\u044B \u0447\u0442\u043E, \u0441 \u0443\u043C\u0430 \u0441\u043E\u0448\u0451\u043B?
      \u041C\u044B \u043E\u0442\u0432\u0435\u0437\u0451\u043C \u044D\u0442\u043E
      \u043D\u0430 \u0441\u043A\u043B\u0430\u0434 \u0438 \u043F\u043E\u043C\u043E\u0436\u0435\u043C
      \u043D\u0430\u0448\u0438\u043C \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0430\u043C."
  - text: "\u4F60\u75AF\u4E86\u5417\uFF1F\u6211\u4EEC\u5F97\u628A\u8FD9\u4E2A\u9001\u5230\u4ED3\u5E93\uFF0C\u7136\u540E\u53BB\u5E2E\u52A9\u6211\u4EEC\u7684\u6218\u53CB\u3002"
