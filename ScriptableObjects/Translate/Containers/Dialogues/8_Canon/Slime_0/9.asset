  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: 9
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: But I have to upset you, your fate is much worse than death. You are a
      hostage to a game.
  - text: "\u042F \u0445\u043E\u0447\u0443 \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0438\u0442\u044C
      \u0442\u0435\u0431\u044F, \u0442\u0432\u043E\u044F \u0441\u0443\u0434\u044C\u0431\u0430
      \u043D\u0430\u043C\u043D\u043E\u0433\u043E \u0445\u0443\u0436\u0435 \u0441\u043C\u0435\u0440\u0442\u0438.
      \u0422\u044B \u0437\u0430\u043B\u043E\u0436\u043D\u0438\u043A \u0438\u0433\u0440\u044B."
  - text: "\u6211\u60F3\u8BA9\u4F60\u96BE\u8FC7\uFF0C\u4F60\u7684\u547D\u8FD0\u6BD4\u7EC8\u7109\u7CDF\u7CD5\u5F97\u591A\u3002\u4F60\u662F\u6E38\u620F\u7684\u56DA\u5F92\u3002"
