  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: Newspaper Tutor
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: "The election of a new ruler plunged the kingdom into civil war. The incumbent,
      \"Prince Slime III,\" is preparing a counter-attack against the new faction
      led by \"Prophet-Brain 738.\" The latter is gaining increasing support by proposing
      reforms designed to improve the nation and transform the Slime Kingdom into
      a great power\u2014goals \"Prince Slime III\" has failed to achieve for decades."
  - text: "\u0412\u044B\u0431\u043E\u0440\u044B \u043D\u043E\u0432\u043E\u0433\u043E
      \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044F \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u0430
      \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u0434\u043B\u044F
      \u0436\u0438\u0442\u0435\u043B\u0435\u0439 \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u043E\u0439
      \u0432\u043E\u0439\u043D\u043E\u0439. \u041D\u044B\u043D\u0435\u0448\u043D\u0438\u0439
      \u043A\u043E\u0440\u043E\u043B\u044C \"\u041F\u0440\u0438\u043D\u0446 \u0441\u043B\u0438\u0437\u0435\u043D\u044C
      III\" \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F \u043E\u0442\u0432\u0435\u0442\u043D\u043E
      \u043D\u0430\u043F\u0430\u0434\u0430\u0442\u044C \u043D\u0430 \u043D\u043E\u0432\u0443\u044E
      \u043F\u0430\u0440\u0442\u0438\u044E \"\u041F\u0440\u043E\u0440\u043E\u043A\u0430-\u043C\u043E\u0437\u0433\u0430
      738\", \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0430\u0431\u0438\u0440\u0430\u0435\u0442
      \u0432\u0441\u0451 \u0431\u043E\u043B\u044C\u0448\u0435 \u0438 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0433\u043E\u043B\u043E\u0441\u043E\u0432, \u043F\u043E\u0441\u043A\u043E\u043B\u044C\u043A\u0443
      \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u0440\u0435\u0444\u043E\u0440\u043C\u044B,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0443\u043B\u0443\u0447\u0448\u0430\u0442
      \u0441\u0442\u0440\u0430\u043D\u0443 \u0438 \u0441\u0434\u0435\u043B\u0430\u044E\u0442
      \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u043E \u0441\u043B\u0430\u0439\u043C\u043E\u0432
      \u0432\u0435\u043B\u0438\u043A\u043E\u0439 \u0434\u0435\u0440\u0436\u0430\u0432\u043E\u0439,
      \u0441 \u0447\u0435\u043C \u043D\u0435 \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \"\u041F\u0440\u0438\u043D\u0446 \u0441\u043B\u0438\u0437\u0435\u043D\u044C
      III\" \u0443\u0436\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u0438\u0439."
  - text: "\u65B0\u56FD\u738B\u7684\u9009\u4E3E\uFF0C\u628A\u5C45\u6C11\u62D6\u5165\u4E86\u5185\u6218\u3002\u73B0\u4EFB\u56FD\u738B\u201C\u53F2\u83B1\u59C6\u738B\u5B50\u4E09\u4E16\u201D\u51C6\u5907\u53CD\u51FB\u65B0\u515A\u6D3E\u201C\u5148\u77E5\u5927\u8111738\u201D\uFF0C\u540E\u8005\u83B7\u5F97\u4E86\u8D8A\u6765\u8D8A\u591A\u7684\u9009\u7968\uFF0C\u56E0\u4E3A\u5B83\u63D0\u51FA\u4E86\u6539\u9769\uFF0C\u5C06\u6539\u5584\u56FD\u5BB6\u5E76\u4F7F\u53F2\u83B1\u59C6\u738B\u56FD\u6210\u4E3A\u4F1F\u5927\u7684\u5F3A\u56FD\uFF0C\u800C\u201C\u53F2\u83B1\u59C6\u738B\u5B50\u4E09\u4E16\u201D\u51E0\u5341\u5E74\u6765\u4E00\u76F4\u672A\u80FD\u505A\u5230\u8FD9\u4E00\u70B9\u3002"
