  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: Book_1
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: One of the penguin scientists from the "Fishing laboratory" has developed
      the best food for growing fish at the moment. It has recently been observed
      that slimes has more energy than native vegetation.
  - text: "\u041E\u0434\u0438\u043D \u0438\u0437 \u043F\u0438\u043D\u0433\u0432\u0438\u043D\u043E\u0432-\u0443\u0447\u0451\u043D\u044B\u0445
      \u0438\u0437 \"\u041B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438
      \u0420\u044B\u0431\u043E\u043B\u043E\u0432\u0441\u0442\u0432\u0430\" \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043B
      \u043B\u0443\u0447\u0448\u0438\u0439 \u043A\u043E\u0440\u043C \u043D\u0430
      \u0434\u0430\u043D\u043D\u044B\u0439 \u043C\u043E\u043C\u0435\u043D\u0442 \u0434\u043B\u044F
      \u0440\u044B\u0431. \u041D\u043E \u043D\u0435\u0434\u0430\u0432\u043D\u043E
      \u043E\u0442\u043A\u0440\u044B\u0442 \u043D\u043E\u0432\u044B\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A
      \u043A\u043E\u0440\u043C\u0430, \u0438\u043C\u0435\u044E\u0449\u0438\u0439
      \u0431\u043E\u043B\u044C\u0448\u0435 \u044D\u043D\u0435\u0440\u0433\u0438\u0438,
      \u0447\u0435\u043C \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F."
  - text: "\u201C\u6E14\u4E1A\u5B9E\u9A8C\u5BA4\u201D\u7684\u4E00\u4F4D\u4F01\u9E45\u79D1\u5B66\u5BB6\u7814\u53D1\u4E86\u76EE\u524D\u6700\u597D\u7684\u9C7C\u9972\u6599\u3002\u4F46\u6700\u8FD1\u53D1\u73B0\u4E86\u4E00\u79CD\u65B0\u7684\u9972\u6599\u6765\u6E90\uFF0C\u6BD4\u690D\u7269\u542B\u6709\u66F4\u591A\u80FD\u91CF\u3002"
