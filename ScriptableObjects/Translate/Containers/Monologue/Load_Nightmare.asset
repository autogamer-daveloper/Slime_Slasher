  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: Load_Nightmare
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: "Why... why am I a victim?  Why... is fate \ndoing this to me?\nCan I change
      anything?..."
  - text: "\u041F\u043E\u0447\u0435\u043C\u0443... \u043F\u043E\u0447\u0435\u043C\u0443
      \u044F \u0436\u0435\u0440\u0442\u0432\u0430? \u041F\u043E\u0447\u0435\u043C\u0443...\n\u0441\u0443\u0434\u044C\u0431\u0430
      \u0442\u0430\u043A \u0441\u043E \u043C\u043D\u043E\u0439 \u043F\u043E\u0441\u0442\u0443\u043F\u0430\u0435\u0442?\n\u041C\u043E\u0433\u0443
      \u043B\u0438 \u044F \u0447\u0442\u043E \u043B\u0438\u0431\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C?..."
