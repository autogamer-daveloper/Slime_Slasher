  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: AOL_ending
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: "First you beg for immortality, then you hate me for it. I\u2019ve had
      enough. I\u2019m going to spin your planet so you suffer forever."
  - text: "C\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u0440\u043E\u0441\u0438\u0442\u0435
      \u0431\u0435\u0441\u0441\u043C\u0435\u0440\u0442\u0438\u0435, \u043F\u043E\u0442\u043E\u043C
      \u0437\u0430 \u044D\u0442\u043E \u0436\u0435 \u0438 \u043D\u0435\u043D\u0430\u0432\u0438\u0434\u0438\u0442\u0435.
      \u041C\u043D\u0435 \u043D\u0430\u0434\u043E\u0435\u043B\u043E, \u044F \u0440\u0430\u0441\u043A\u0440\u0443\u0447\u0443
      \u0432\u0430\u0448\u0443 \u043F\u043B\u0430\u043D\u0435\u0442\u0443, \u0447\u0442\u043E\u0431\u044B
      \u0432\u044B \u043C\u0443\u0447\u0430\u043B\u0438\u0441\u044C \u0432\u0435\u0447\u043D\u043E."
