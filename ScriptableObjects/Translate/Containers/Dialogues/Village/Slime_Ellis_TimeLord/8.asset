  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: Thanks to Joe, we slipped you a knife so you could escape, in return we
      only ask for help.
  - text: "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0414\u0436\u043E,
      \u043C\u044B \u043F\u043E\u0434\u043B\u043E\u0436\u0438\u043B\u0438 \u0442\u0435\u0431\u0435
      \u043D\u043E\u0436, \u0447\u0442\u043E\u0431\u044B \u0442\u044B \u0441\u0431\u0435\u0436\u0430\u043B,
      \u0438 \u043C\u044B \u043F\u0440\u043E\u0441\u0438\u043C \u0442\u0435\u0431\u044F
      \u043E \u043F\u043E\u043C\u043E\u0449\u0438."
