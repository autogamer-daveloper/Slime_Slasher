  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: Don't worry, you're not here forever, there's a portal deep in the prison,
      go to it.
  - text: "\u041D\u0435 \u0432\u043E\u043B\u043D\u0443\u0439\u0441\u044F, \u0442\u044B
      \u0437\u0434\u0435\u0441\u044C \u043D\u0435 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430,
      \u0433\u043B\u0443\u0431\u043E\u043A\u043E \u0432 \u0442\u044E\u0440\u044C\u043C\u0435
      \u0435\u0441\u0442\u044C \u043F\u043E\u0440\u0442\u0430\u043B, \u0438\u0434\u0438
      \u043A \u043D\u0435\u043C\u0443."
  - text: "\u522B\u62C5\u5FC3\uFF0C\u4F60\u4E0D\u4F1A\u6C38\u8FDC\u7559\u5728\u8FD9\u91CC\uFF0C\u76D1\u72F1\u6DF1\u5904\u6709\u4E00\u4E2A\u4F20\u9001\u95E8\uFF0C\u53BB\u90A3\u91CC\u5427\u3002"
