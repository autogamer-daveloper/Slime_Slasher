  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: 14
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: And so I myself created the war. You already know the outcome. All the
      slimes died.
  - text: "\u0418 \u0442\u0430\u043A \u044F \u0441\u0430\u043C \u0437\u0430\u0432\u044F\u0437\u0430\u043B
      \u0432\u043E\u0439\u043D\u0443. \u0422\u044B \u0441\u0430\u043C \u0437\u043D\u0430\u0435\u0448\u044C
      \u0438\u0441\u0445\u043E\u0434. \u0412\u0441\u0435 \u0441\u043B\u0430\u0439\u043C\u044B
      \u043C\u0435\u0440\u0442\u0432\u044B."
  - text: "\u5C31\u8FD9\u6837\uFF0C\u6211\u81EA\u5DF1\u6311\u8D77\u4E86\u6218\u4E89\u3002\u4F60\u81EA\u5DF1\u77E5\u9053\u7ED3\u5C40\u3002\u6240\u6709\u53F2\u83B1\u59C6\u90FD\u6D88\u901D\u4E86\u3002"
