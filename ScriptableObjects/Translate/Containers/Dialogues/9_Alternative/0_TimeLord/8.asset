  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: 8
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: Everyone hated him, humiliated him, laughed at him, but he just wanted
      to live like everyone else.
  - text: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0435\u0433\u043E \u043D\u0435\u043D\u0430\u0432\u0438\u0434\u0435\u043B,
      \u0443\u043D\u0438\u0436\u0430\u043B, \u0441\u043C\u0435\u044F\u043B\u0441\u044F
      \u043D\u0430\u0434 \u043D\u0438\u043C, \u043D\u043E \u043E\u043D \u043F\u0440\u043E\u0441\u0442\u043E
      \u0445\u043E\u0442\u0435\u043B \u0436\u0438\u0442\u044C, \u043A\u0430\u043A
      \u0432\u0441\u0435."
  - text: "\u6BCF\u4E2A\u4EBA\u90FD\u6068\u4ED6\u3001\u7F9E\u8FB1\u4ED6\u3001\u5632\u7B11\u4ED6\uFF0C\u4F46\u4ED6\u53EA\u662F\u60F3\u548C\u5927\u5BB6\u4E00\u6837\u6D3B\u7740\u3002"
