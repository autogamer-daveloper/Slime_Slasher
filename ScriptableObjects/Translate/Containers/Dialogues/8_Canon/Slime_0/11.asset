  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: 11
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: Everyone you saw, except me, is hostage to this game, you will never get
      out of here.
  - text: "\u0412\u0441\u0435, \u043A\u043E\u0433\u043E \u0442\u044B \u0432\u0438\u0434\u0435\u043B,
      \u043A\u0440\u043E\u043C\u0435 \u043C\u0435\u043D\u044F, \u0437\u0430\u043B\u043E\u0436\u043D\u0438\u043A\u0438
      \u044D\u0442\u043E\u0439 \u0438\u0433\u0440\u044B, \u0432\u044B \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u043E\u0442\u0441\u044E\u0434\u0430 \u043D\u0435 \u0432\u044B\u0431\u0435\u0440\u0435\u0442\u0435\u0441\u044C."
