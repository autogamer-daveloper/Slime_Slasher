  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: 2
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: I'm sorry that I couldn't warn you, but... death was our fate, I realized
      this only in the future.
  - text: "\u0418\u0437\u0432\u0438\u043D\u0438, \u044F \u043D\u0435 \u0441\u043C\u043E\u0433
      \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0434\u0438\u0442\u044C \u0432\u0430\u0441,
      \u043D\u043E... \u0441\u043C\u0435\u0440\u0442\u044C \u043D\u0430\u0448\u0430
      \u0441\u0443\u0434\u044C\u0431\u0430, \u0438 \u044F \u044D\u0442\u043E \u043F\u043E\u043D\u044F\u043B
      \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043C."
  - text: "\u5BF9\u4E0D\u8D77\uFF0C\u6211\u6CA1\u80FD\u8B66\u544A\u4F60\u4EEC\uFF0C\u4F46\u2026\u2026\u7EC8\u7109\u662F\u6211\u4EEC\u7684\u547D\u8FD0\uFF0C\u6211\u662F\u5728\u672A\u6765\u624D\u660E\u767D\u7684\u3002"
