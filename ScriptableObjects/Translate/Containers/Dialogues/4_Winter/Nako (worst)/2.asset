  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: 2
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: You are so callous... I hope all your journey will be in vain. Die.
  - text: "\u0422\u044B \u0442\u0430\u043A\u043E\u0439 \u0447\u0451\u0440\u0441\u0442\u0432\u044B\u0439...
      \u043D\u0430\u0434\u0435\u044E\u0441\u044C \u0432\u0435\u0441\u044C \u0442\u0432\u043E\u0439
      \u043F\u0443\u0442\u044C \u0431\u0443\u0434\u0435\u0442 \u043D\u0430\u043F\u0440\u0430\u0441\u043D\u044B\u043C.
      \u0421\u0434\u043E\u0445\u043D\u0438."
  - text: "\u4F60\u771F\u662F\u51B7\u9177\u2026\u2026\u6211\u5E0C\u671B\u4F60\u6574\u4E2A\u65C5\u7A0B\u90FD\u662F\u5F92\u52B3\u7684\u3002\u6D88\u5931\u5427\u3002"
