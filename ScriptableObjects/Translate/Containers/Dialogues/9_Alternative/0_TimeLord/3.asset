  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: 3
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: Time Lord, you did your job well, and now I myself will explain to the
      player what happened.
  - text: "\u041F\u043E\u0432\u0435\u043B\u0438\u0442\u0435\u043B\u044C \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
      \u0442\u044B \u0441\u0434\u0435\u043B\u0430\u043B \u0440\u0430\u0431\u043E\u0442\u0443
      \u043E\u0442\u043B\u0438\u0447\u043D\u043E, \u0442\u0435\u043F\u0435\u0440\u044C
      \u044F \u0441\u0430\u043C \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443
      \u0438\u0433\u0440\u043E\u043A\u0443, \u0447\u0442\u043E \u0442\u0443\u0442
      \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E."
  - text: "\u65F6\u95F4\u9886\u4E3B\uFF0C\u4F60\u505A\u5F97\u5F88\u597D\uFF0C\u73B0\u5728\u6211\u81EA\u5DF1\u6765\u544A\u8BC9\u73A9\u5BB6\u8FD9\u91CC\u53D1\u751F\u4E86\u4EC0\u4E48\u3002"
