  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: Letter
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: "Dear player. It's me, Autogamer (Developer).\n\nI\u2019m writing to you
      for a reason, that 0, didn\u2019t you find him strange? That he knows too much?
      So... He shouldn't have existed, because of 1 mistake this character appeared
      and stole the power of the game engine.\nUnlike everyone else, after starting
      a new game he does not reset his memory, he remembers everything... Delete
      the game as soon as possible, he can go into other apps and cause chaos...
      FaaassstttNOOOtfsjdkfhfkjd##..."
  - text: "\u0414\u043E\u0440\u043E\u0433\u043E\u0439 \u0438\u0433\u0440\u043E\u043A.
      \u042D\u0442\u043E \u044F, Autogamer (\u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A).\r\n\r\n\u042F
      \u043F\u0438\u0448\u0443 \u0442\u0435\u0431\u0435 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0442\u0430\u043A, \u044D\u0442\u043E\u0442 0, \u043E\u043D \u0442\u0435\u0431\u0435
      \u043D\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u043C?
      \u0427\u0442\u043E \u043E\u043D \u0437\u043D\u0430\u0435\u0442 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043C\u043D\u043E\u0433\u043E? \u0418\u0442\u0430\u043A... \u0415\u0433\u043E
      \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u043B\u043E
      \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C, \u0438\u0437-\u0437\u0430
      1 \u043E\u0448\u0438\u0431\u043A\u0438 \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
      \u044D\u0442\u043E\u0442 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436 \u0438
      \u0443\u043A\u0440\u0430\u043B \u043C\u043E\u0449\u044C \u0438\u0433\u0440\u043E\u0432\u043E\u0433\u043E
      \u0434\u0432\u0438\u0436\u043A\u0430.\r\n\u0412 \u043E\u0442\u043B\u0438\u0447\u0438\u0438
      \u043E\u0442 \u0432\u0441\u0435\u0445, \u043F\u043E\u0441\u043B\u0435 \u0437\u0430\u043F\u0443\u0441\u043A\u0430
      \u043D\u043E\u0432\u043E\u0439 \u0438\u0433\u0440\u044B \u043E\u043D \u043D\u0435
      \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442 \u043F\u0430\u043C\u044F\u0442\u044C,
      \u0432\u0441\u0435 \u043F\u043E\u043C\u043D\u0438\u0442... \u0423\u0434\u0430\u043B\u0438
      \u0438\u0433\u0440\u0443 \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E
      \u0441\u043A\u043E\u0440\u0435\u0435, \u043E\u043D \u043C\u043E\u0436\u0435\u0442
      \u0437\u0430\u0439\u0442\u0438 \u0432 \u0434\u0440\u0443\u0433\u0438\u0435
      \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u0438 \u0443\u0441\u0442\u0440\u043E\u0438\u0442\u044C
      \u0445\u0430\u043E\u0441... \u0411\u044B\u0441\u0442\u0440\u0435\u0435\u0435\u0435\u041D\u0415\u0415\u0415\u0422\u0422\u043F\u0432\u0430\u0445\u0444\u043A\u0434\u0436\u0434##..."
