  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: Help us improve the game by writing a review and receive an exclusive military
      helmet in return.
  - text: "\u041F\u043E\u043C\u043E\u0433\u0438\u0442\u0435 \u043D\u0430\u043C \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C
      \u0438\u0433\u0440\u0443, \u043D\u0430\u043F\u0438\u0441\u0430\u0432 \u043E\u0442\u0437\u044B\u0432,
      \u0432\u0437\u0430\u043C\u0435\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435
      \u044D\u043A\u0441\u043A\u043B\u044E\u0437\u0438\u0432\u043D\u044B\u0439 \u0432\u043E\u0435\u043D\u043D\u044B\u0439
      \u0448\u043B\u0435\u043C."
