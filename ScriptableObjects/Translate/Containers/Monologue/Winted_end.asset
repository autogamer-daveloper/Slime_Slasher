  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: Winted_end
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: 'Finally I found a way out of here,

      soon I will kill the brain...
      wait, ah,

      what scratched me?'
  - text: "\u041D\u0430\u043A\u043E\u043D\u0435\u0446 \u044F \u043D\u0430\u0448\u0451\u043B
      \u0434\u043E\u0440\u043E\u0433\u0443 \u043E\u0442\u0441\u044E\u0434\u0430,\n\u0441\u043A\u043E\u0440\u043E
      \u044F \u043F\u0440\u0438\u043A\u043E\u043D\u0447\u0443 \u043C\u043E\u0437\u0433\u0430...
      \u043F\u043E\u0433\u043E\u0434\u0438, \u0430\u0445,\n\u0447\u0442\u043E \u043F\u043E\u0446\u0430\u0440\u0430\u043F\u0430\u043B\u043E
      \u043C\u0435\u043D\u044F?"
  - text: "\u6211\u7EC8\u4E8E\u627E\u5230\u4E86\u79BB\u5F00\u8FD9\u91CC\u7684\u65B9\u6CD5\uFF0C\r\n\u5F88\u5FEB\u6211\u5C31\u80FD\u7EC8\u7ED3\u5927\u8111\u2026\u2026\u7B49\u7B49\uFF0C\u554A\uFF0C\r\n\u662F\u4EC0\u4E48\u5212\u4F24\u4E86\u6211\uFF1F"
