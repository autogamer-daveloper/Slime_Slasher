  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: 2
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: "I just did what I had to do, killed the wild, and now I don\u2019t see
      the meaning of life."
  - text: "\u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u043B\u0430
      \u0442\u043E, \u0447\u0442\u043E \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u043B\u0430
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C, \u0443\u0431\u0438\u043B\u0430
      \u0412\u0438\u043B\u0434\u0430 \u0438 \u0442\u0435\u043F\u0435\u0440\u044C
      \u043D\u0435 \u0432\u0438\u0436\u0443 \u0441\u043C\u044B\u0441\u043B\u0430
      \u0436\u0438\u0437\u043D\u0438."
  - text: "\u6211\u53EA\u662F\u505A\u4E86\u6211\u8BE5\u505A\u7684\u4E8B\uFF0C\u51FB\u8D25\u4E86\u7EF4\u5C14\u5FB7\uFF0C\u73B0\u5728\u89C9\u5F97\u6D3B\u7740\u6CA1\u6709\u610F\u4E49\u3002"
