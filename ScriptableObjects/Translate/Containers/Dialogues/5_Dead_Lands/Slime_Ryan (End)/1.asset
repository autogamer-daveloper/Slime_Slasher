  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: 1
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: "Wait, before my death, can you answer my question, why you didn\u2019t
      help us?"
  - text: "\u041F\u043E\u0434\u043E\u0436\u0434\u0438, \u043F\u0435\u0440\u0435\u0434
      \u043C\u043E\u0435\u0439 \u0441\u043C\u0435\u0440\u0442\u044C\u044E... \u043C\u043E\u0433\u0443
      \u043B\u0438 \u044F \u0443\u0437\u043D\u0430\u0442\u044C \u043E\u0442\u0432\u0435\u0442
      \u043D\u0430 \u0432\u043E\u043F\u0440\u043E\u0441? \u041F\u043E\u0447\u0435\u043C\u0443
      \u0442\u044B \u043D\u0435 \u043F\u043E\u043C\u043E\u0433 \u043D\u0430\u043C?"
  - text: "\u7B49\u7B49\uFF0C\u5728\u6211\u7684\u7EC8\u7109\u4E4B\u524D\u2026\u2026\u6211\u80FD\u77E5\u9053\u4E00\u4E2A\u95EE\u9898\u7684\u7B54\u6848\u5417\uFF1F\u4F60\u4E3A\u4EC0\u4E48\u4E0D\u5E2E\u52A9\u6211\u4EEC\uFF1F"
