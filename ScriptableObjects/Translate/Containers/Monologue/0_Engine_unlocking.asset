  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: 0_Engine_unlocking
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: And so, a 0 - created by an error and triggered by a virus - hacked its
      way into the engine and stole infinity power.
  - text: "\u0418 \u0442\u0430\u043A, 0, \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0439
      \u0438\u0437-\u0437\u0430 \u043E\u0448\u0438\u0431\u043A\u0438, \u0432\u044B\u0437\u0432\u0430\u043D\u043D\u044B\u0439
      \u0432\u0438\u0440\u0443\u0441\u043E\u043C, \u0432\u0437\u043B\u043E\u043C\u0430\u043B
      \u0434\u043E\u0441\u0442\u0443\u043F \u043A \u0434\u0432\u0438\u0436\u043A\u0443
      \u0438 \u0443\u043A\u0440\u0430\u043B \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u0443\u044E
      \u043C\u043E\u0449\u044C."
