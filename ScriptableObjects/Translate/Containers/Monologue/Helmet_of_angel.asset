  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: Helmet_of_angel
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: You could have died if not for the helmet. You spent about six months in
      the hospital after the injury. The General is dead. Prince Slime III was killed.
      You were imprisoned for your ties to the opposition.
  - text: "\u0422\u044B \u043C\u043E\u0433 \u043F\u043E\u0433\u0438\u0431\u043D\u0443\u0442\u044C,
      \u0435\u0441\u043B\u0438 \u0431\u044B \u043D\u0435 \u0448\u043B\u0435\u043C.
      \u0422\u044B \u043F\u0440\u043E\u0432\u0435\u043B \u0432 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0435
      \u043E\u043A\u043E\u043B\u043E \u043F\u043E\u043B\u0443 \u0433\u043E\u0434\u0430
      \u043F\u043E\u0441\u043B\u0435 \u0442\u0440\u0430\u0432\u043C\u044B. \u0413\u0435\u043D\u0435\u0440\u0430\u043B
      \u043C\u0451\u0440\u0442\u0432, \u041F\u0440\u0438\u043D\u0446 \u0421\u043B\u0430\u0439\u043C
      III \u0431\u044B\u043B \u0443\u0431\u0438\u0442. \u0422\u0435\u0431\u044F \u043F\u043E\u0441\u0430\u0434\u0438\u043B\u0438
      \u0432 \u0442\u044E\u0440\u044C\u043C\u0443 \u0437\u0430 \u0441\u0432\u044F\u0437\u044C
      \u0441 \u043E\u043F\u043F\u043E\u0437\u0438\u0446\u0438\u043E\u043D\u043D\u043E\u0439
      \u0432\u043B\u0430\u0441\u0442\u044C\u044E."
  - text: "\u5982\u679C\u4E0D\u662F\u5934\u76D4\uFF0C\u4F60\u53EF\u80FD\u5DF2\u7ECF\u6B7B\u4E86\u3002\u53D7\u4F24\u540E\u4F60\u5728\u533B\u9662\u5F85\u4E86\u5927\u7EA6\u534A\u5E74\u3002\u5C06\u519B\u6B7B\u4E86\uFF0C\u53F2\u83B1\u59C6\u738B\u5B50\u4E09\u4E16\u88AB\u6740\u4E86\u3002\u4F60\u56E0\u4E0E\u53CD\u5BF9\u6D3E\u5F53\u5C40\u6709\u8054\u7CFB\u800C\u88AB\u5173\u8FDB\u76D1\u72F1\u3002"
