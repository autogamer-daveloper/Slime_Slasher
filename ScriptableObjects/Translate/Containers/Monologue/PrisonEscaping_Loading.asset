  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: PrisonEscaping_Loading
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: "I can\u2019t live like this anymore, I have to escape...\nit\u2019s so
      good that among the pile of garbage I\nfound a small knife, I\u2019ll try to
      break the door"
  - text: "\u042F \u043D\u0435 \u043C\u043E\u0433\u0443 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0442\u0430\u043A \u0436\u0438\u0442\u044C, \u044F \u0434\u043E\u043B\u0436\u0435\u043D
      \u0441\u0431\u0435\u0436\u0430\u0442\u044C...\n\u041A\u0430\u043A \u0436\u0435
      \u0445\u043E\u0440\u043E\u0448\u043E, \u0447\u0442\u043E \u0441\u0440\u0435\u0434\u0438
      \u043C\u0443\u0441\u043E\u0440\u0430 \u044F \u043D\u0430\u0448\u0435\u043B
      \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439\n\u0441\u0442\u0430\u0440\u044B\u0439
      \u043D\u043E\u0436\u0438\u043A, \u044F \u043F\u043E\u043F\u044B\u0442\u0430\u044E\u0441\u044C
      \u0438\u043C \u0432\u0437\u043B\u043E\u043C\u0430\u0442\u044C \u0434\u0432\u0435\u0440\u044C"
  - text: "\u6211\u4E0D\u80FD\u518D\u8FD9\u6837\u6D3B\u4E0B\u53BB\u4E86\uFF0C\u6211\u5FC5\u987B\u9003\u8D70\u2026\u2026\r\n\u5E78\u597D\u6211\u5728\u5783\u573E\u5806\u91CC\u627E\u5230\u4E86\u4E00\u628A\u5C0F\u5C0F\u7684\r\n\u65E7\u5200\uFF0C\u6211\u8981\u8BD5\u7740\u7528\u5B83\u64AC\u5F00\u95E8\u3002"
