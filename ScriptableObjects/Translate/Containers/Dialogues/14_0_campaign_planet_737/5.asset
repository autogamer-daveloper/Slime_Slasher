  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: 5
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: It is not my fault that you failed to take this disease into account. Be
      grateful that you at least attained immortality.
  - text: "\u042D\u0442\u043E \u043D\u0435 \u043C\u043E\u044F \u0432\u0438\u043D\u0430,
      \u0447\u0442\u043E \u0432\u044B \u043D\u0435 \u0443\u0447\u043B\u0438 \u044D\u0442\u0443
      \u0431\u043E\u043B\u0435\u0437\u043D\u044C. \u0411\u0443\u0434\u044C\u0442\u0435
      \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u044B, \u0447\u0442\u043E
      \u0432\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u0431\u0435\u0441\u0441\u043C\u0435\u0440\u0442\u0438\u0435."
  - text: "\u4F60\u4EEC\u6CA1\u8003\u8651\u5230\u8FD9\u79CD\u75BE\u75C5\u4E0D\u662F\u6211\u7684\u9519\u3002\u4F60\u4EEC\u5F97\u5230\u4E86\u6C38\u751F\uFF0C\u8BE5\u611F\u6069\u624D\u662F\u3002"
