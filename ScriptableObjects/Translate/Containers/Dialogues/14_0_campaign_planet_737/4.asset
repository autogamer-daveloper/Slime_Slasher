  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: 4
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: It is not our fault that we didn't know about the disease that would shackle
      us inside these robots.
  - text: "\u041C\u044B \u043D\u0435 \u0432\u0438\u043D\u043E\u0432\u0430\u0442\u044B,
      \u0447\u0442\u043E \u043D\u0435 \u0437\u043D\u0430\u043B\u0438 \u043E \u0431\u043E\u043B\u0435\u0437\u043D\u0438,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0437\u0430\u043A\u0443\u0451\u0442
      \u043D\u0430\u0441 \u0432 \u0440\u043E\u0431\u043E\u0442\u043E\u0432 \u0438
      \u0431\u0443\u0434\u0435\u0442 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C
      \u044D\u043D\u0435\u0440\u0433\u0438\u044E."
  - text: "\u6211\u4EEC\u4E0D\u77E5\u9053\u6709\u4E00\u79CD\u75BE\u75C5\u4F1A\u628A\u6211\u4EEC\u9501\u8FDB\u673A\u5668\u4EBA\u5E76\u9700\u8981\u80FD\u91CF\uFF0C\u8FD9\u4E0D\u662F\u6211\u4EEC\u7684\u9519\u3002"
