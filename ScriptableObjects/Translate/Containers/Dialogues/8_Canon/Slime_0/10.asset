  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: 10
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: The game was created outside of our world, I am the moderator, and you,
      the doll, entertain the viewer.
  - text: "\u0418\u0433\u0440\u0430, \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u0430\u044F
      \u0432\u043D\u0435 \u043D\u0430\u0448\u0435\u0433\u043E \u043C\u0438\u0440\u0430,
      \u044F \u043A\u0430\u043A \u043C\u043E\u0434\u0435\u0440\u0430\u0442\u043E\u0440,
      \u0438 \u0432\u044B, \u043A\u0443\u043A\u043B\u044B, \u043F\u0440\u043E\u0441\u0442\u043E
      \u0440\u0430\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0435 \u0434\u043B\u044F
      \u0437\u0440\u0438\u0442\u0435\u043B\u044F."
  - text: "\u4E00\u4E2A\u5728\u6211\u4EEC\u4E16\u754C\u4E4B\u5916\u521B\u9020\u7684\u6E38\u620F\uFF0C\u6211\u662F\u7BA1\u7406\u5458\uFF0C\u800C\u4F60\u4EEC\u8FD9\u4E9B\u6728\u5076\uFF0C\u53EA\u662F\u89C2\u4F17\u7684\u5A31\u4E50\u3002"
