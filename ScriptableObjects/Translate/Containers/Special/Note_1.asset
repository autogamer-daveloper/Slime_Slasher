  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: Note_1
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: Since you paid us with resources, we will protect you and keep an eye on
      the slimes, we also trained our dark "death ninja", you can take over the planet!
  - text: "\u041F\u043E\u0441\u043B\u0435 \u0432\u0430\u0448\u0435\u0439 \u043E\u043F\u043B\u0430\u0442\u044B
      \u0440\u0435\u0441\u0443\u0440\u0441\u0430\u043C\u0438, \u043C\u044B \u0431\u0443\u0434\u0435\u043C
      \u0437\u0430\u0449\u0438\u0449\u0430\u0442\u044C \u0432\u0430\u0441 \u0438
      \u0441\u043B\u0435\u0434\u0438\u0442\u044C \u0437\u0430 \u0441\u043B\u0430\u0439\u043C\u0430\u043C\u0438.
      \u041C\u044B \u0442\u0430\u043A\u0436\u0435 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u0430\u043B\u0438
      \u043D\u0430\u0448\u0435\u0433\u043E \"\u043D\u0438\u043D\u0434\u0437\u044F
      \u0441\u043C\u0435\u0440\u0442\u0438\", \u0442\u0430\u043A \u0447\u0442\u043E
      \u043F\u043B\u0430\u043D\u0435\u0442\u0430 \u0443\u0436\u0435 \u0432\u0430\u0448\u0430!"
  - text: "\u5728\u60A8\u7528\u8D44\u6E90\u652F\u4ED8\u540E\uFF0C\u6211\u4EEC\u5C06\u4FDD\u62A4\u60A8\u5E76\u76D1\u89C6\u53F2\u83B1\u59C6\u3002\u6211\u4EEC\u8FD8\u8BAD\u7EC3\u4E86\u6211\u4EEC\u7684\u201C\u7EC8\u7109\u5FCD\u8005\u201D\uFF0C\u6240\u4EE5\u8FD9\u4E2A\u661F\u7403\u5DF2\u7ECF\u662F\u60A8\u7684\u4E86\uFF01"
