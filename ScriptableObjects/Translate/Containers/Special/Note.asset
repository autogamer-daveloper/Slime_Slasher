  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: Note
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: "Unlocked: backstory\n\nWhile serving in the army, the player was injured,
      making it dangerous to continue serving, which is why he was finally able to
      retire and go to a remote village with his family. But after becoming king,
      \u201CBrain 738\u201D ordered all former military personnel to be arrested,
      since they knew too much."
  - text: "\u0420\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043E:
      \u043F\u0440\u0435\u0434\u044B\u0441\u0442\u043E\u0440\u0438\u044F\n\n\u0412\u043E
      \u0432\u0440\u0435\u043C\u044F \u0441\u043B\u0443\u0436\u0431\u044B \u0432
      \u0430\u0440\u043C\u0438\u0438 \u0438\u0433\u0440\u043E\u043A \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0440\u0430\u043D\u0435\u043D\u0438\u0435, \u043F\u0440\u0438 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C \u0441\u043B\u0443\u0436\u0431\u0443
      \u0431\u044B\u043B\u043E \u043E\u043F\u0430\u0441\u043D\u043E, \u043E\u0442\u0447\u0435\u0433\u043E
      \u043E\u043D \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u0441\u043C\u043E\u0433
      \u0432\u044B\u0439\u0442\u0438 \u0432 \u043E\u0442\u0441\u0442\u0430\u0432\u043A\u0443
      \u0438 \u0443\u0435\u0445\u0430\u0442\u044C \u0432 \u0433\u043B\u0443\u0445\u0443\u044E
      \u0434\u0435\u0440\u0435\u0432\u043D\u044E \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441\u043E \u0441\u0432\u043E\u0435\u0439 \u0441\u0435\u043C\u044C\u0451\u0439.
      \u041D\u043E \u043F\u043E\u0441\u043B\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
      \u043A\u043E\u0440\u043E\u043B\u0451\u043C \"\u041C\u043E\u0437\u0433 738\"
      \u043F\u0440\u0438\u043A\u0430\u0437\u0430\u043B \u0432\u0441\u0435\u0445 \u0431\u044B\u0432\u0448\u0438\u0445
      \u0432\u043E\u0435\u043D\u043D\u044B\u0445 \u0430\u0440\u0435\u0441\u0442\u043E\u0432\u0430\u0442\u044C,
      \u0442\u0430\u043A \u043A\u0430\u043A \u043E\u043D\u0438 \u0437\u043D\u0430\u043B\u0438
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E."
  - text: "\u5DF2\u89E3\u9501\uFF1A\u80CC\u666F\u6545\u4E8B\r\n\r\n\u5728\u519B\u961F\u670D\u5F79\u671F\u95F4\uFF0C\u73A9\u5BB6\u53D7\u4E86\u4F24\uFF0C\u7EE7\u7EED\u670D\u5F79\u5F88\u5371\u9669\uFF0C\u56E0\u6B64\u4ED6\u7EC8\u4E8E\u5F97\u4EE5\u9000\u5F79\uFF0C\u548C\u5BB6\u4EBA\u4E00\u8D77\u642C\u5230\u4E86\u4E00\u4E2A\u504F\u50FB\u7684\u6751\u5E84\u3002\u4F46\u5728\u201C\u5927\u8111738\u201D\u6210\u4E3A\u56FD\u738B\u540E\uFF0C\u4ED6\u4E0B\u4EE4\u902E\u6355\u6240\u6709\u524D\u519B\u4EBA\uFF0C\u56E0\u4E3A\u4ED6\u4EEC\u77E5\u9053\u5F97\u592A\u591A\u4E86\u3002"
