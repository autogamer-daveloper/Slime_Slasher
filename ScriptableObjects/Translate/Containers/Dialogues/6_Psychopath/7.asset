  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: 7
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: They all died while protecting your world, and what did you do? Have you
      decided to give up?
  - text: "\u0412\u0441\u0435 \u043E\u043D\u0438 \u0443\u043C\u0435\u0440\u043B\u0438,
      \u0437\u0430\u0449\u0438\u0449\u0430\u044F \u0442\u0432\u043E\u0439 \u043C\u0438\u0440,
      \u0430 \u0447\u0442\u043E \u0442\u044B \u0441\u0434\u0435\u043B\u0430\u043B?
      \u0422\u0443\u043F\u043E \u0440\u0435\u0448\u0438\u043B \u0441\u0434\u0430\u0442\u044C\u0441\u044F?"
  - text: "\u4ED6\u4EEC\u90FD\u4E3A\u4E86\u4FDD\u62A4\u4F60\u7684\u4E16\u754C\u800C\u6D88\u901D\u4E86\uFF0C\u800C\u4F60\u505A\u4E86\u4EC0\u4E48\uFF1F\u53EA\u662F\u51B3\u5B9A\u653E\u5F03\uFF1F"
