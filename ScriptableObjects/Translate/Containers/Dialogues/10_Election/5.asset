  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: 5
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: I don't need your money. I'll distribute tax revenues fairly across all
      sectors.
  - text: "\u041C\u043D\u0435 \u043D\u0435 \u043D\u0443\u0436\u043D\u044B \u0432\u0430\u0448\u0438
      \u0434\u0435\u043D\u044C\u0433\u0438. \u042F \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u044E
      \u043D\u0430\u043B\u043E\u0433\u0438 \u0432\u043E \u0432\u0441\u0435 \u043E\u0442\u0440\u0430\u0441\u043B\u0438
      \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0438."
  - text: "\u6211\u4E0D\u9700\u8981\u4F60\u4EEC\u7684\u94B1\u3002\u6211\u4F1A\u5C06\u7A0E\u6536\u6536\u5165\u5206\u914D\u7ED9\u7ECF\u6D4E\u5404\u4E2A\u90E8\u95E8\u3002"
