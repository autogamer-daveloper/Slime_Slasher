  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: "I\u2019m just fed up with everything. Everyone mocks me and treats me
      like I\u2019m nothing."
  - text: "\u0414\u0430 \u043C\u043D\u0435 \u0443\u0436\u0435 \u0432\u0441\u0451
      \u043D\u0430\u0434\u043E\u0435\u043B\u043E, \u0432\u0441\u0435 \u043D\u0430\u0434\u043E
      \u043C\u043D\u043E\u0439 \u0438\u0437\u0434\u0435\u0432\u0430\u044E\u0442\u0441\u044F,
      \u043D\u0438 \u0432\u043E \u0447\u0442\u043E \u043C\u0435\u043D\u044F \u043D\u0435
      \u0441\u0442\u0430\u0432\u044F\u0442."
