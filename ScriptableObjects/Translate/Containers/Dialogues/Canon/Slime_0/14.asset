  m_Name: 14
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: Why is the world so cruel? Why didn't I die the quiet life of a family
      man? WHY AM I FORCED TO FIGHT?!
  - text: "\u041F\u043E\u0447\u0435\u043C\u0443 \u043C\u0438\u0440 \u0442\u0430\u043A\u043E\u0439
      \u0436\u0435\u0441\u0442\u043E\u043A\u0438\u0439? \u041F\u043E\u0447\u0435\u043C\u0443
      \u044F \u043D\u0435 \u0443\u043C\u0435\u0440 \u043E\u0431\u044B\u0447\u043D\u044B\u043C
      \u0441\u0435\u043C\u0435\u0439\u043D\u044B\u043C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C?
      \u041F\u041E\u0427\u0415\u041C\u0423 \u042F \u0412\u042B\u041D\u0423\u0416\u0414\u0415\u041D
      \u0412\u041E\u0415\u0412\u0410\u0422\u042C?!"
