  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: 8
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: "Stay in the core. I\u2019ll let you out as soon as I get back. But don\u2019t
      interfere again."
  - text: "\u041F\u043E\u0441\u0438\u0434\u0438 \u0432 \u044F\u0434\u0440\u0435,
      \u043A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u0435\u0440\u043D\u0443\u0441\u044C,
      \u0432\u044B\u043F\u0443\u0449\u0443, \u0441 \u0443\u0441\u043B\u043E\u0432\u0438\u0435\u043C,
      \u0447\u0442\u043E \u0442\u044B \u043D\u0435 \u0431\u0443\u0434\u0435\u0448\u044C
      \u043C\u043D\u0435 \u043C\u0435\u0448\u0430\u0442\u044C."
  - text: "\u5728\u6838\u5FC3\u91CC\u5F85\u7740\uFF0C\u6211\u4E00\u56DE\u6765\u5C31\u653E\u4F60\u51FA\u6765\uFF0C\u6761\u4EF6\u662F\u4F60\u522B\u59A8\u788D\u6211\u3002"
