  m_Script: {fileID: 11500000, guid: 0c2a180cf03e06e4ca9c64ef0f953832, type: 3}
  m_Name: 10
  m_EditorClassIdentifier: Assembly-CSharp::TranslateContainer
  texts:
  - text: This world is too small for my honor and your selfishness, fight me or
      I will die myself.
  - text: "\u042D\u0442\u043E\u0442 \u043C\u0438\u0440 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043C\u0430\u043B \u0434\u043B\u044F \u043C\u043E\u0435\u0439 \u0447\u0435\u0441\u0442\u0438
      \u0438 \u0442\u0432\u043E\u0435\u0433\u043E \u044D\u0433\u043E\u0438\u0437\u043C\u0430,
      \u0441\u0440\u0430\u0437\u0438\u0441\u044C \u0441\u043E \u043C\u043D\u043E\u0439,
      \u0438\u043B\u0438 \u044F \u0443\u043C\u0440\u0443 \u0441\u0430\u043C."
  - text: "\u8FD9\u4E2A\u4E16\u754C\u5BF9\u6211\u7684\u8363\u8A89\u548C\u4F60\u7684\u81EA\u79C1\u6765\u8BF4\u592A\u5C0F\u4E86\uFF0C\u548C\u6211\u6218\u6597\uFF0C\u5426\u5219\u6211\u81EA\u5DF1\u6D88\u901D\u3002"
